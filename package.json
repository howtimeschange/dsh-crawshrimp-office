{
  "name": "dsh-crawshrimp-office",
  "version": "0.2.0",
  "description": "面向 DeepSeek Harness（DSH）的本地 Word、PowerPoint 与 OOXML 文档工具；local DOCX/PPTX tools for DSH",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "SECURITY.md",
    "LICENSE",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/permissions.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.4 <0.2.1-alpha.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/howtimeschange/dsh-crawshrimp-office.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "crawshrimp",
    "ooxml",
    "office",
    "docx",
    "pptx",
    "markdown"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2",
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "0.6.1",
    "docx": "9.7.1",
    "mammoth": "1.13.0",
    "pptxgenjs": "4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4"
  }
}
